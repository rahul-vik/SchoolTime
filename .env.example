PORT=8787
NODE_ENV=development
JWT_SECRET=replace-with-a-strong-32-char-min-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_MAX=120
CORS_ORIGIN=http://localhost:5173
# Current runtime DB engine (sqlite | postgres). Runtime is sqlite by default; postgres migration is supported via scripts.
DB_CLIENT=sqlite
# Required when using DB_CLIENT=postgres and for migration script `npm run migrate:postgres`.
DATABASE_URL=
# --- One-time: copy one org from prod Postgres → local SQLite (`npm run import:prod-org:local -- --school "Name"`) ---
# Never commit real URLs/passwords. Use a read-only DB user for IMPORT_SOURCE_DATABASE_URL when possible.
# IMPORT_SOURCE_DATABASE_URL=
# IMPORT_I_UNDERSTAND_COPY_TO_LOCAL=YES
# IMPORT_LOCAL_PLAINTEXT_PASSWORD=at-least-12-chars
# IMPORT_ORG_ID=           # optional if multiple schools match IMPORT_SCHOOL_NAME
# IMPORT_SCHOOL_NAME=Surana
# IMPORT_ORG_NAME_SUFFIX= (local import)
# IMPORT_EMAIL_TAG=import
# IMPORT_PRESERVE_ORG_CREATED_AT=YES   # optional: keep prod org created_at (school sorts to bottom of creator list)
# Full URL (default) or same-origin in dev: /api (requires Vite proxy + API on port 8787)
VITE_API_BASE_URL=http://localhost:8787/api
# Platform portal (http://localhost:5173/creator). Login password: 66914810
# Development: plain password is enough.
CREATOR_PORTAL_PASSWORD=66914810
# Production: use this bcrypt hash (same password 66914810). Plain passwords under 20 chars are rejected when NODE_ENV=production unless a hash is set.
# When HASH is set, it is checked first at login.
CREATOR_PORTAL_PASSWORD_HASH=$2b$10$JxuFRJgxKi3bLDNjf3Ywn.Us6zbxwGrCAWXUu7uWJUbs8WOrgrsKS
# Creator JWT expiry (default 8h)
CREATOR_JWT_EXPIRES_IN=8h
# Password reset email (SMTP) - optional but recommended
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS on 587; true = implicit TLS (typical for port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional tuning when the app cannot reach SMTP (timeouts, IPv6 issues on some hosts)
# SMTP_CONNECTION_TIMEOUT_MS=45000
# SMTP_SOCKET_TIMEOUT_MS=120000
# SMTP_FORCE_IPV4=1
# SMTP_REQUIRE_TLS=auto (default) | on | off — auto uses requireTLS on port 587 with SMTP_SECURE=false
# Public app URL used in reset links, e.g. https://rahul-vik.github.io/SchoolTime
APP_BASE_URL=http://localhost:5173
# Timetable generation solver: legacy (default, in-process greedy engine) or experimental (worker + timeout; v0 delegates to same engine for plumbing tests; falls back to legacy on worker error/timeout).
TIMETABLE_SOLVER=legacy
# Max wall time (ms) for experimental worker pass before falling back to legacy (capped at 300000).
TIMETABLE_SOLVER_TIMEOUT_MS=30000
