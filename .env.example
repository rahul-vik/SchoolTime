PORT=8787
NODE_ENV=development
JWT_SECRET=replace-with-a-strong-32-char-min-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_MAX=120
CORS_ORIGIN=http://localhost:5173
# Current runtime DB engine (sqlite | postgres). Runtime is sqlite by default; postgres migration is supported via scripts.
DB_CLIENT=sqlite
# Required when using DB_CLIENT=postgres and for migration script `npm run migrate:postgres`.
DATABASE_URL=
# Full URL (default) or same-origin in dev: /api (requires Vite proxy + API on port 8787)
VITE_API_BASE_URL=http://localhost:8787/api
