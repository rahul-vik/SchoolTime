{
  "name": "schooltime",
  "private": true,
  "version": "1.0.9",
  "author": "Rahul V",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "npm run dev:all",
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "branch:dev": "git checkout develop",
    "branch:prod": "git checkout main",
    "start:dev": "npm run branch:dev && npm run dev:all",
    "start:prod": "npm run branch:prod && npm run build && concurrently \"npm run preview\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:prod": "node scripts/smoke-check.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "import:prod-org:local": "node scripts/import-prod-org-to-local-sqlite.mjs",
    "migrate:tenant-state:backfill": "node scripts/backfill-tenant-migrations.mjs",
    "migrate:tenant-state:backfill:apply": "node scripts/backfill-tenant-migrations.mjs --apply",
    "migrate:timetable-run-state": "node scripts/backfill-timetable-run-state.mjs",
    "migrate:timetable-run-state:apply": "node scripts/backfill-timetable-run-state.mjs --apply",
    "migrate:all:check": "npm run migrate:tenant-state:backfill && npm run migrate:timetable-run-state",
    "migrate:all": "npm run migrate:tenant-state:backfill:apply && npm run migrate:timetable-run-state:apply",
    "prod:preflight": "node scripts/prod-deploy-preflight.mjs",
    "deploy:verify-aws": "node scripts/aws/verify-aws-deploy.mjs",
    "test:shared": "node --test tests/shared/academic-list-filters.test.mjs tests/shared/division-scheduling.test.mjs tests/shared/teacher-capacity.test.mjs tests/shared/teacher-workload.test.mjs tests/shared/tenant-preflight-check.test.mjs tests/shared/tenant-feasibility-report.test.mjs tests/shared/engine-placement-phases.test.mjs tests/shared/engine-slot-order.test.mjs tests/shared/school-display-order.test.mjs tests/shared/recompute-timetable-report.test.mjs",
    "test:backend:validation": "node --test tests/backend/timetable-validation-autofix.test.mjs tests/backend/timetable-validation-extended.test.mjs",
    "test:engine:regression": "node --test tests/backend/engine-regression-fixture.test.mjs",
    "test:backend:engine": "node --test tests/backend/engine-include-only.test.mjs tests/backend/engine-division-subject-locks.test.mjs tests/backend/engine-team-teaching.test.mjs tests/backend/engine-regression-fixture.test.mjs tests/backend/timetable-validation-extended.test.mjs tests/backend/timetable-solver-env-default.test.mjs tests/backend/legacy-quality-profile.test.mjs tests/backend/tenant-state-migration-prune.test.mjs tests/backend/school-display-order.test.mjs tests/backend/class-teacher-enabled.test.mjs tests/backend/sqlite-migrations.test.mjs tests/backend/prod-migration-safety.test.mjs tests/backend/timetable-solver-runner.test.mjs tests/backend/engine-lock-repair.test.mjs tests/backend/legacy-engine-improvements.test.mjs tests/backend/legacy-engine-local-search.test.mjs tests/backend/legacy-engine-phases.test.mjs tests/backend/legacy-engine-period-spread.test.mjs tests/backend/platform-org-bundle.test.mjs tests/backend/cpsat-request-builder.test.mjs tests/backend/cpsat-solve-response-adapter.test.mjs",
    "export:last-run": "node scripts/export-last-timetable-run.mjs",
    "check:tenant": "node scripts/check-tenant.mjs",
    "solver:cpsat": "python solver/cpsat/service.py 8790",
    "lambda:cpsat:docker-build": "docker build -f solver/cpsat/Dockerfile.lambda -t schooltime-cpsat-lambda .",
    "lambda:cpsat:deploy-checklist": "node scripts/aws/deploy-cpsat-lambda.mjs",
    "test:solver:lambda": "python tests/solver/test_lambda_handler.py",
    "test:postgres:integration": "node scripts/postgres-integration-check.mjs",
    "docs:auto": "node scripts/auto-docs-rules.mjs",
    "release:prepare": "node scripts/prepare-release-branch.mjs",
    "release:sync-develop": "node scripts/sync-develop-with-main.mjs",
    "health:daily": "npm run build && npm run smoke:prod && npm run audit:security",
    "autofix:risk-gate": "node scripts/autofix-risk-gate.mjs",
    "check:release-governance": "node scripts/check-release-governance.mjs",
    "check:versioning": "node scripts/check-versioning-local.mjs",
    "verify:push": "node scripts/verify-before-push.mjs",
    "prepare": "node scripts/husky-prepare.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "vite": "^5.4.10"
  }
}
