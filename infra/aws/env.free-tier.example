# SchoolTime — EC2 + RDS Free Tier (copy to ~/SchoolTime/.env on the server; never commit)

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

DB_CLIENT=postgres
# RDS Easy Create often uses database "postgres" (not "schooltime"). No ?sslmode= on Docker.
DATABASE_URL=postgresql://schooltime:CHANGE_ME@YOUR_RDS_ENDPOINT.ap-south-2.rds.amazonaws.com:5432/postgres

JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_MAX=120

# GitHub Pages origin (no trailing slash)
CORS_ORIGIN=https://rahul-vik.github.io
APP_BASE_URL=https://rahul-vik.github.io/SchoolTime

# GitHub Actions variable (not in this file): VITE_API_BASE_URL=https://schooltime-api.duckdns.org/api

# bcrypt hash — see docs/AWS_FREE_TIER_SETUP.md Part 5.4
CREATOR_PORTAL_PASSWORD_HASH=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Leave empty — legacy engine (Free Tier RAM)
# CP_SAT_SOLVER_URL=
