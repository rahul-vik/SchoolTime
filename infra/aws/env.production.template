# SchoolTime API — production (AWS EC2 Docker or App Runner / ECS)
# Copy values into EC2 .env, AWS console, or Secrets Manager. Do not commit filled secrets.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Amazon RDS PostgreSQL (EC2 Docker: no ?sslmode= in URL; confirm DB name in RDS console)
DB_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_MAX=120

# GitHub Pages origin (exact match, no path) — e.g. https://rahul-vik.github.io
CORS_ORIGIN=https://YOUR_USER.github.io

# Public SPA URL (password-reset links)
APP_BASE_URL=https://YOUR_USER.github.io/SchoolTime

# GitHub repo Actions variable (not on server): VITE_API_BASE_URL=https://<api-host>/api

# Platform portal (/creator) — use bcrypt hash in production
CREATOR_PORTAL_PASSWORD_HASH=
CREATOR_JWT_EXPIRES_IN=8h

# SMTP (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Timetable solver (optional CP-SAT on AWS — not Render)
# CP_SAT_SOLVER_URL=https://xxx.lambda-url.region.on.aws/solve
# CP_SAT_SOLVER_SECRET=
TIMETABLE_SOLVER_TIMEOUT_MS=90000

# Build metadata (optional — set in CI/CD)
# GITHUB_SHA=
# APP_BUILD_NUMBER=
